<Window x:Class="DistributedRayTrace.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Distributed Ray Trace 1.0.0"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Menu x:Name="ApplicationMenu" Background="Transparent" Padding="4,0">
                <MenuItem Header="_Remote" Click="OpenRemote_Click" />
                <MenuItem Header="_Settings">
                    <MenuItem x:Name="ResolutionSettingsMenuItem" Header="Resolution / Display Settings"
                              Command="{Binding OpenSettingsCommand}" />
                    <MenuItem Header="Scene Inspection" Click="OpenSceneInspection_Click" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="User Guide" Command="{Binding OpenUserGuideCommand}" />
                    <MenuItem Header="Benchmark Information" Command="{Binding OpenBenchmarkInformationCommand}" />
                    <MenuItem Header="Clear Local Cache" Command="{Binding ClearLocalCacheCommand}"
                              ToolTip="Delete saved renders and run logs when no render is active." />
                    <Separator />
                    <MenuItem Header="About" Command="{Binding OpenAboutCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <Grid Grid.Row="1" Margin="16,18,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="3" Height="26" Background="{StaticResource AccentBrush}" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="Distributed Ray Trace" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="CPU SERIAL / LOCAL / DYNAMIC TLS LAN" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="332" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="SidebarScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" PanningMode="VerticalOnly" AutomationProperties.Name="Benchmark information sidebar">
                <StackPanel Margin="0,0,4,0">
                    <Border x:Name="PerformancePanel" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="PERFORMANCE" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock Text="{Binding WorkloadDescription}" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="CPU Local All Core" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding LocalScoreText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding LocalResultDetail}" />
                                <Button Grid.Column="2" Content="{Binding AllCoreActionText}" Command="{Binding AllCoreActionCommand}" Padding="6,4" VerticalAlignment="Center"
                                        ToolTipService.ShowOnDisabled="True" ToolTip="{Binding LocalCapacityText}" AutomationProperties.Name="{Binding AllCoreActionName}" />
                                <TextBlock Grid.Row="1" Text="CPU Distributed All Core" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DistributedScoreText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding DistributedResultDetail}" />
                                <Button Grid.Row="1" Grid.Column="2" Content="{Binding DistributedActionText}" Command="{Binding DistributedActionCommand}" Padding="8,4" VerticalAlignment="Center"
                                        ToolTipService.ShowOnDisabled="True" ToolTip="{Binding DistributedCapacityText}" AutomationProperties.Name="{Binding DistributedActionName}" />
                                <TextBlock Grid.Row="2" Text="CPU Serial Preview" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="SerialScore" Grid.Row="2" Grid.Column="1" Text="{Binding SerialScoreText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Margin="0,0,10,0" ToolTip="{Binding SerialResultDetail}" AutomationProperties.Name="CPU Serial Preview score" />
                                <Button Grid.Row="2" Grid.Column="2" Content="{Binding LocalActionText}" Command="{Binding LocalActionCommand}" Padding="6,4" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding LocalActionName}" />
                            </Grid>
                            <TextBlock Text="{Binding LocalCapacityText}" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,10" />
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Distributed vs Local" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding EfficiencyText}" FontSize="11" ToolTip="{Binding ComparisonNotice}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SystemPanel" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="YOUR SYSTEM" Style="{StaticResource SectionHeadingStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Processor" Style="{StaticResource SystemLabelStyle}" />
                                <TextBlock x:Name="ProcessorValue" Grid.Column="1" Text="{Binding SystemInformation.Processor}" ToolTip="{Binding SystemInformation.ProcessorDetails}" Style="{StaticResource SystemValueStyle}" />
                                <TextBlock Grid.Row="1" Text="Cores × GHz" Style="{StaticResource SystemLabelStyle}" />
                                <TextBlock x:Name="CoresValue" Grid.Row="1" Grid.Column="1" Text="{Binding SystemInformation.CoresAndClock}" ToolTip="{Binding SystemInformation.CoresDetails}" Style="{StaticResource SystemValueStyle}" />
                                <TextBlock Grid.Row="2" Text="GPU" Style="{StaticResource SystemLabelStyle}" />
                                <TextBlock x:Name="GpuValue" Grid.Row="2" Grid.Column="1" Text="{Binding SystemInformation.Gpu}" ToolTip="{Binding SystemInformation.GpuDetails}" Style="{StaticResource SystemValueStyle}" />
                                <TextBlock Grid.Row="3" Text="Operating System" Style="{StaticResource SystemLabelStyle}" />
                                <TextBlock x:Name="OperatingSystemValue" Grid.Row="3" Grid.Column="1" Text="{Binding SystemInformation.OperatingSystem}" ToolTip="{Binding SystemInformation.OperatingSystem}" Style="{StaticResource SystemValueStyle}" />
                                <TextBlock Grid.Row="4" Text="Info" Style="{StaticResource SystemLabelStyle}" />
                                <TextBlock x:Name="InfoValue" Grid.Row="4" Grid.Column="1" Text="{Binding SystemInformation.Info}" ToolTip="{Binding SystemInformation.Info}" Style="{StaticResource SystemValueStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RemoteSystemsPanel" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="REMOTE SYSTEMS" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock Text="{Binding RemoteSystemsText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RemoteStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding DistributedCapacityText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="ContributionPanel" Style="{StaticResource CardStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{Binding ContributionHeading}" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock Text="{Binding ContributionStatus}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding WorkerRows}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" Margin="0,0,0,4" />
                                            <Grid Height="27" Background="{StaticResource InsetBrush}" ClipToBounds="True">
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding SharePercent, Mode=OneWay}" Height="27" BorderThickness="0" Opacity="0.55" />
                                                <TextBlock Text="{Binding CountText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2" x:Name="RenderingViewport">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="{Binding ViewportTitle}" Style="{StaticResource TableHeadingStyle}" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Right" Background="{StaticResource AccentSurfaceBrush}"
                            BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1" Padding="8,4" CornerRadius="2">
                        <TextBlock Text="{Binding PreviewLabel}" ToolTip="{Binding PreviewError}" Foreground="{StaticResource AccentBrush}" FontSize="10" />
                    </Border>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource ViewportBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="1">
                    <Viewbox x:Name="PreviewViewbox" Stretch="Uniform">
                        <Grid x:Name="PreviewFrame" Width="{Binding PreviewCanvasWidth}" Height="{Binding PreviewCanvasHeight}" Background="{StaticResource ViewportBrush}">
                            <TextBlock x:Name="PreviewUnavailable" Text="Reference preview unavailable" FontSize="32"
                                       Visibility="{Binding IsPreviewUnavailable, Converter={StaticResource BooleanVisibility}}"
                                       Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="ReferencePreview" Stretch="Uniform" AutomationProperties.Name="{Binding PreviewDescription}">
                                <Image.Style><Style TargetType="Image"><Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                                </Style></Image.Style>
                            </Image>
                        </Grid>
                    </Viewbox>
                </Border>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="{Binding PbrDiagnostics}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                    <TextBlock Text="{Binding RunNotice}" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                </Grid>
                <TextBlock Grid.Row="3" Text="{Binding ErrorFeedback}" Foreground="{StaticResource ErrorTextBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="Run or preview error">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>


        <Border Grid.Row="3" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,11,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="STATUS" Style="{StaticResource StatusLabelStyle}" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                        <TextBlock x:Name="CurrentStatus" Text="{Binding StatusText}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="BACKEND" Style="{StaticResource StatusLabelStyle}" />
                    <TextBlock x:Name="BackendStatus" Text="{Binding BackendStatus}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,24,0">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="PROGRESS" Style="{StaticResource TableHeadingStyle}" />
                        <TextBlock x:Name="ProgressText" Text="{Binding ProgressText}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar x:Name="RenderProgress" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Height="3" AutomationProperties.Name="Accepted pixel samples" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="{Binding ElapsedLabel}" Style="{StaticResource StatusLabelStyle}" />
                    <TextBlock x:Name="ElapsedTime" Text="{Binding ElapsedText}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="RENDER RESOLUTION" Style="{StaticResource StatusLabelStyle}" />
                    <TextBlock x:Name="TargetResolution" Text="{Binding TargetResolution}" ToolTip="{Binding ResolutionNotice}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
