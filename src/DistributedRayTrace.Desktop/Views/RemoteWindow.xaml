<Window x:Class="DistributedRayTrace.Desktop.Views.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Agents" Width="900" Height="700" MinWidth="650" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18">
                    <TextBlock Text="TRUSTED REMOTE AGENTS" Style="{StaticResource SectionHeadingStyle}" />
                    <TextBlock Text="Import a local topology containing the certificates and pinned identities you trust. Select paired Agents, then discover and connect to those endpoints." TextWrapping="Wrap" Margin="0,10,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Import trusted topology" Click="PairAgents_Click" IsEnabled="{Binding CanEditRemote}" Padding="12,7" Margin="0,0,10,0" />
                        <Button Content="Discover / connect selected" Command="{Binding ConnectRemoteCommand}" Padding="12,7" Margin="0,0,10,0" />
                        <Button Content="Disconnect" Command="{Binding DisconnectRemoteCommand}" Padding="12,7" />
                    </StackPanel>
                    <TextBlock Text="{Binding RemoteStatus}" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <ItemsControl ItemsSource="{Binding RemotePeers}" IsEnabled="{Binding CanEditRemote}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <CheckBox Content="{Binding Id}" IsChecked="{Binding Selected,Mode=TwoWay}" AutomationProperties.Name="{Binding Id}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Endpoint}" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding State}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Capability}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBlock Text="Certificate SHA256 pin" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,3" />
                                        <TextBlock Text="{Binding Fingerprint}" FontFamily="Consolas" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Pairing, selection and live availability are independent. Distributed requires every selected Agent to be connected, authenticated and compatible. Unknown devices are never paired automatically." TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>
</Window>
